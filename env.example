# ===========================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ===========================================

# Окружение приложения
NODE_ENV=production

# Порт для приложения
PORT=3000

# ===========================================
# БАЗА ДАННЫХ
# ===========================================

# Полная строка подключения к PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Настройки PostgreSQL (если не указаны в DATABASE_URL)
POSTGRES_DB=myapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# ===========================================
# TELEGRAM BOT
# ===========================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# URL для webhook (должен быть HTTPS)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# ===========================================
# REDIS
# ===========================================

# URL подключения к Redis
REDIS_URL=redis://localhost:6379

# ===========================================
# МОНИТОРИНГ
# ===========================================

# Пароль администратора Grafana
GRAFANA_ADMIN_PASSWORD=admin_password

# Пароль для Prometheus
PROMETHEUS_PASSWORD=prometheus_password

# ===========================================
# NGINX (если используется)
# ===========================================

# Домен для nginx
NGINX_DOMAIN=your-domain.com

# Email для SSL сертификатов
NGINX_SSL_EMAIL=your-email@domain.com

# ===========================================
# ЛОГИРОВАНИЕ
# ===========================================

# Уровень логирования
LOG_LEVEL=info

# ===========================================
# БЕЗОПАСНОСТЬ
# ===========================================

# Секретный ключ для JWT (если используется)
JWT_SECRET=your_jwt_secret_key_here

# Соль для хеширования паролей
BCRYPT_SALT_ROUNDS=12

# ===========================================
# НАСТРОЙКИ ПРОВЕРКИ ЦЕН
# ===========================================

# Интервал проверки цен для бесплатных пользователей (в часах)
DEFAULT_CHECK_INTERVAL_HOURS=6

# Интервал проверки цен для PRO пользователей (в часах)
PRO_CHECK_INTERVAL_HOURS=1

# Максимальное количество товаров для бесплатных пользователей
FREE_TIER_MAX_PRODUCTS=10

# Максимальное количество товаров для PRO пользователей
PRO_TIER_MAX_PRODUCTS=50

# ===========================================
# ПРОВАЙДЕРЫ
# ===========================================

# Включить провайдер Wildberries
ENABLE_WILDBERRIES_PROVIDER=true

# Включить провайдер Яндекс.Маркет
ENABLE_YANDEX_MARKET_PROVIDER=true

# ===========================================
# РАЗРАБОТКА (только для dev окружения)
# ===========================================

# Автоперезагрузка при изменениях
NODEMON_ENABLED=false

# Отладка
DEBUG=false

# ===========================================
# PUPPETEER НАСТРОЙКИ
# ===========================================

# Пропуск загрузки Chrome (для Docker)
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Путь к Chrome в системе
CHROME_BIN=/usr/bin/chromium-browser