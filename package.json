{
  "name": "price-watcher-bot",
  "version": "1.0.0",
  "description": "Telegram bot for monitoring product prices",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' nodemon src/index.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc",
    "build:prod": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.prod.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "queue:worker": "tsx src/workers/price-checker.ts",
    "queue:notify": "tsx src/workers/notifier.ts",
    "debug:queues": "node scripts/debug-queues.js",
    "debug:tracks": "node scripts/debug-tracks.js",
    "debug:workers": "node scripts/debug-workers.js",
    "restore:jobs": "node scripts/restore-recurring-jobs.js",
    "test:analytics": "node scripts/test-analytics.js",
    "monitoring:start": "./scripts/start-monitoring.sh",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "code:fix": "npm run format && npm run lint:fix"
  },
  "keywords": [
    "telegram",
    "bot",
    "price",
    "monitoring",
    "ecommerce"
  ],
  "author": "Price Watcher Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bullmq": "^5.0.4",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.0",
    "prisma": "^5.7.1",
    "prom-client": "^15.1.0",
    "puppeteer": "^21.11.0",
    "telegraf": "^4.15.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
